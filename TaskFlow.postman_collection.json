{
  "info": {
    "name": "TaskFlow - CRUD Testleri",
    "description": "Sunucuyu açık tut. Beş isteği sırayla gönder. İlk istek yeni görev numarasını kaydeder.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://127.0.0.1:3000",
      "type": "string"
    },
    {
      "key": "taskId",
      "value": "0",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. Görev ekle",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 201', () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) {",
              "  const created = pm.response.json();",
              "  pm.test('Görev numarası üretildi', () => {",
              "    pm.expect(created.id).to.be.a('number');",
              "  });",
              "  pm.collectionVariables.set('taskId', String(created.id));",
              "}"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"title\": \"Abonelikleri kontrol et\",\n  \"description\": \"Bu ayki abonelik ödemelerini listele.\",\n  \"assignee\": \"Deniz\",\n  \"priority\": \"medium\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "2. Görevleri listele",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Yeni görev listede', () => {",
              "  const id = Number(pm.collectionVariables.get('taskId'));",
              "  pm.expect(pm.response.json().some((task) => task.id === id)).to.be.true;",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks"
      }
    },
    {
      "name": "3. Görev detayı",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('İstenen görev döndü', () => {",
              "  pm.expect(pm.response.json().id).to.equal(Number(pm.collectionVariables.get('taskId')));",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      }
    },
    {
      "name": "4. Görevi güncelle",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Görev tamamlandı', () => {",
              "  pm.expect(pm.response.json().status).to.equal('completed');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "PATCH",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": "{{baseUrl}}/tasks/{{taskId}}",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"status\": \"completed\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "5. Görevi sil",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
              "pm.test('Silme onayı döndü', () => {",
              "  pm.expect(pm.response.json().message).to.equal('Görev silindi.');",
              "});"
            ]
          }
        }
      ],
      "request": {
        "method": "DELETE",
        "header": [],
        "url": "{{baseUrl}}/tasks/{{taskId}}"
      }
    }
  ]
}
